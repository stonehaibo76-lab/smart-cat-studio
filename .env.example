# --- Frontend (Vite) ---
# API base URL; local dev uses local Node server
VITE_API_BASE_URL=http://127.0.0.1:58741
# Legacy alias (still supported)
# VITE_LOCAL_DB_URL=http://127.0.0.1:58741
# Require login when API is not localhost (auto-detected if unset)
# VITE_REQUIRE_AUTH=true

# Gemini API key (optional; users can also configure in Settings)
GEMINI_API_KEY=

# --- Backend (Node server) ---
# Cloud mode: set DATABASE_URL to use PostgreSQL + JWT auth
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Local SQLite only
SMARTCAT_LOCAL_DB_PORT=58741
# SMARTCAT_DB_PATH=
# SMARTCAT_SETTINGS_ORG_ID=
# SMARTCAT_BIND_ALL=1
